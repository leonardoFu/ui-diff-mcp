{
  "name": "ui-diff-mcp",
  "version": "1.0.0",
  "description": "MCP server for UI design vs implementation comparison using SSIM/PSNR/VMAF metrics",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ui-diff": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:clean": "rimraf test-artifacts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "clean": "npm run test:clean && rimraf dist"
  },
  "keywords": [
    "mcp",
    "ui",
    "diff",
    "ssim",
    "psnr",
    "vmaf",
    "image-comparison"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "sharp": "^0.33.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
